# Copy to .env and fill in. These override config.yaml values.

# Путь к конфигу приложения (по умолчанию config.yaml в корне)
CONFIG=config.yaml

# PostgreSQL — строка подключения для приложения (схема создаётся автоматически при старте).
# Формат: postgresql+asyncpg://ЮЗЕР:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
# Из docker-контейнера используйте host.docker.internal:5432 вместо localhost.
DATABASE__DSN=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/news

# Отдельная база для интеграционных тестов (pytest); можно указать ту же базу.
TEST_DSN=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/news_test

# LLM — API-ключ OpenAI-compatible шлюза (OpenRouter, OpenCode Go и т.п.).
LLM__API_KEY=sk-...

# Tavily — ключ поиска фото. Бесплатный ключ: https://tavily.com
TAVILY__API_KEY=tvly-...

# Telegram-бот: @BotFather -> /newbot -> токен.
TELEGRAM__BOT_TOKEN=123456:ABC...
