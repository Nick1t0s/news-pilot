# Copy to .env and fill in. These override config.yaml values.

CONFIG=config.yaml

# PostgreSQL connection: user, password and database name are all set here.
# From a docker container use host.docker.internal:5432 instead of localhost.
DATABASE__DSN=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/news
# DSN for integration tests (can be the same database):
TEST_DSN=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/news
LLM__API_KEY=sk-...
TAVILY__API_KEY=tvly-...
TELEGRAM__BOT_TOKEN=123456:ABC...
